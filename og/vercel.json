{
  "rewrites": [
    { "source": "/r/:id", "destination": "/api/share?id=:id" },
    { "source": "/r", "destination": "/api/share" },
    { "source": "/b", "destination": "/api/share?board=1" },
    { "source": "/card", "destination": "/api/card" },
    { "source": "/", "destination": "/api/share" }
  ],
  "functions": {
    "api/*.js": { "includeFiles": "{lib,assets}/**" }
  }
}
